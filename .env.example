# 複製為 .env 後修改（.env 禁止提交到 git）。欄位說明見 docs/architecture/overview.md 第 4 節。
# .env 只放 app/core/config.py 中 Settings 的欄位；Uvicorn 參數（例如 FORWARDED_ALLOW_IPS）請用命令列或另外的環境變數，
# 否則 Settings 的 extra='forbid' 會讓啟動失敗。

# 環境別：development / test / production
APP_ENV=development
# production 必須為 false，否則啟動失敗
APP_DEBUG=false

# SECRET_KEY 用途：經 derive_key('login-csrf') 衍生「登入前 CSRF Token」的 HMAC 金鑰（ADR-002 4.4）。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
# production 長度須 ≥ 32 且不得使用下方範例值或 change-me（列於 app/core/config.py 的 FORBIDDEN_SECRET_KEYS），否則啟動失敗。
# 更換影響：所有已開啟但尚未送出的登入頁會失效（送出得到 403，重新整理即可）；已登入的 Session 不受影響。
SECRET_KEY=replace-with-output-of-secrets-token-urlsafe-64-do-not-use-this-example-value

# SQLite 資料庫路徑：只接受 sqlite:/// 開頭；相對路徑以專案根目錄解析
DATABASE_URL=sqlite:///./data/app.db
# SQLite 等待寫鎖的上限（毫秒），範圍 100～60000（ADR-003）
DATABASE_BUSY_TIMEOUT_MS=5000

# 顯示與規則判斷共用的時區（資料庫一律存 UTC，ADR-004）
APP_TIMEZONE=Asia/Taipei

# 允許的 Host 標頭（逗號分隔）；production 不可為空或包含 *
ALLOWED_HOSTS=localhost,127.0.0.1
# 請求本體上限（位元組），範圍 1024～1048576；超過回 413
MAX_REQUEST_BODY_BYTES=65536

# Session
# production 必須以 __Host- 開頭（例如 __Host-tku_session）且 SESSION_COOKIE_SECURE=true；
# 名稱以 __Host- 開頭時，不論環境 SESSION_COOKIE_SECURE 都必須為 true
SESSION_COOKIE_NAME=tku_session
SESSION_COOKIE_SECURE=false
# 閒置逾時（秒）
SESSION_MAX_AGE_SECONDS=1800
# 絕對逾時（秒），須 ≥ SESSION_MAX_AGE_SECONDS（ADR-001）
SESSION_ABSOLUTE_MAX_AGE_SECONDS=28800

# 登入前 CSRF Token 有效期（秒），範圍 300～86400（ADR-002）
LOGIN_CSRF_MAX_AGE_SECONDS=3600

# 登入失敗鎖定（ADR-005）：嘗試上限範圍 1～100；LOGIN_LOCKOUT_SECONDS 同時是計數時間窗與鎖定時間
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# 每個 worker 同時進行的 argon2 雜湊運算上限，範圍 1～32；名額已滿的登入立即回 503（ADR-005 第 6 節）。
# 記憶體峰值 ≈ Uvicorn worker 數 × PASSWORD_HASH_CONCURRENCY × 64 MiB（預設 1 worker 約 256 MiB），主機需預留。
PASSWORD_HASH_CONCURRENCY=4

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
