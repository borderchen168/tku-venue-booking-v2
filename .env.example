# 環境別：development / test / production
APP_ENV=development
APP_DEBUG=false

# 以 python -c "import secrets; print(secrets.token_urlsafe(64))" 產生，禁止使用範例值
SECRET_KEY=change-me

# SQLite 資料庫路徑
DATABASE_URL=sqlite:///./data/app.db

# 顯示時區（資料庫一律存 UTC）
APP_TIMEZONE=Asia/Taipei

# Session
SESSION_COOKIE_NAME=tku_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=1800

# 登入失敗鎖定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

LOG_LEVEL=INFO
